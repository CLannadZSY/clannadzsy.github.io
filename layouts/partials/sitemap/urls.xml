{{- $seen := .seen -}}
{{- $visited := .visited | default (newScratch) -}}
{{- range .pages -}}
  {{- $url := .Permalink -}}
  {{- if and (ne .Params.sitemap_exclude true) (not ($seen.Get $url)) -}}
    {{- $seen.Set $url true -}}
  <url>
    <loc>{{ $url }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML (.Lastmod.Format "2006-01-02T15:04:05-07:00") }}</lastmod>{{ end }}{{ with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>{{ end }}{{ if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>{{ end }}{{ if .IsTranslated }}{{ range .Translations }}{{ if ne .Params.sitemap_exclude true }}
    <xhtml:link rel="alternate" hreflang="{{ .Lang }}" href="{{ .Permalink }}"/>{{ end }}{{ end }}
    <xhtml:link rel="alternate" hreflang="{{ .Lang }}" href="{{ $url }}"/>{{ end }}
  </url>
  {{- end -}}
  {{- if and .IsSection (not ($visited.Get $url)) -}}
    {{- $visited.Set $url true -}}
    {{- partial "sitemap/urls.xml" (dict "pages" .Pages "seen" $seen "visited" $visited) -}}
  {{- end -}}
{{- end -}}
